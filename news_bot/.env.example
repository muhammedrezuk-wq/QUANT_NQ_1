# توكن البوت من BotFather — لا يُكتب هنا أبدًا، فقط في .env المحلي
BOT_TOKEN=
# رقم محادثتك مع البوت
OWNER_CHAT_ID=
TIMEZONE=Europe/Istanbul
MORNING_REPORT_HOUR=14
MORNING_REPORT_MINUTE=00
DATA_DIR=data
LOG_DIR=logs
NQ_BRAIN_PATH=

# ── الأجندة الاقتصادية (من تقويم ميتاتريدر عبر قاعدة الجسر — بلا مفتاح API) ──
# اتركه فارغًا ليستعمل المسار الافتراضي:
# %APPDATA%\MetaQuotes\Terminal\Common\Files\nq_brain.db
NQ_BRIDGE_DB=
# العملة المطلوبة: USD أو EUR… أو ALL لكل العملات
CAL_CURRENCY=USD
# أدنى أهمية تُنشر: NONE / LOW / MEDIUM / HIGH
CAL_MIN_IMPACT=MEDIUM
# كم دقيقة قبل الحدث يوصل التنبيه
CAL_ALERT_MINUTES=15
# ── النشر التلقائي للأخبار ──────────────────────────────────────────
# off = لا يُنشر شيء تلقائيًّا (الافتراضي) · on = يُنشر مع كل دورة سحب (١٠ د)
NEWS_PUSH=off
# أدنى أثر يُنشر تلقائيًّا: HIGH أو MEDIUM
NEWS_PUSH_MIN_IMPACT=HIGH
# سقف الأخبار في الدورة الواحدة — حتى لا يُغرق الطلّاب
NEWS_PUSH_MAX_PER_RUN=3
# أقصى عمر للخبر المنشور تلقائيًّا (بالدقائق). والخبر بلا وقت نشر لا يُنشر
# تلقائيًّا إطلاقًا: «الآن» لا تُقال عن خبر لا نعرف متى وقع.
NEWS_PUSH_MAX_AGE_MIN=120
